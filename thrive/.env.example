# Copy to .env and fill in real values (SRS NFR-09 - environment-based secrets).

# SQLite for local development:
DATABASE_URL="file:./dev.db"
# PostgreSQL for institutional deployment (also set provider="postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://thrive:password@localhost:5432/thrive?schema=public"

# Signing key for session tokens. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Absolute path for uploaded thesis documents. Leave empty to use ./storage/documents.
STORAGE_DIR=""
