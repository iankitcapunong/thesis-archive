# Copy to .env and fill in real values (SRS NFR-09 - environment-based secrets).

# SQLite for local development:
DATABASE_URL="file:./dev.db"
# PostgreSQL for institutional deployment (also set provider="postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://thrive:password@localhost:5432/thrive?schema=public"

# Signing key for session tokens. Minimum 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Google sign-in (optional). Leave both blank to disable it — the buttons then
# never render and the routes refuse politely, so password sign-in still works.
# Create an OAuth 2.0 Web application client at https://console.cloud.google.com
# and register this exact redirect URI:
#   http://localhost:3000/api/auth/google/callback   (development)
#   https://thrive.carsu.edu.ph/api/auth/google/callback  (production)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL. Required only behind a reverse proxy, where the inbound
# request origin is the proxy's rather than the site's.
# APP_URL="https://thrive.carsu.edu.ph"

# First administrator, created by `npm run db:seed`.
# Leave ADMIN_PASSWORD unset to have a strong one generated and printed once.
ADMIN_EMAIL="admin@carsu.edu.ph"
# ADMIN_PASSWORD=""

# Absolute path for uploaded thesis documents.
# Leave this line commented out to use the default ./storage/documents.
# Do not set it to an empty string — that resolves to the project root.
# STORAGE_DIR="/var/lib/thrive/documents"
